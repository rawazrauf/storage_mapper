        "#@title 4. Run Sliding-Window YOLO-OBB Detection, Audit Recall & Export GeoJSON\n",
        "import io\n",
        "from PIL import Image\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "TILE_URL = \"https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}\"\n",
        "WIN_PX = 1024\n",
        "STRIDE_PX = 768\n",
        "MIN_ASPECT = 0.65   # reject elongated non-cylindrical boxes\n",
        "MIN_DIAM_M = 5.0\n",
        "\n",
        "session = requests.Session()\n",
        "session.headers.update({\"User-Agent\": \"StorageMapper-Pilot/2.0\"})\n",
        "\n",
        "if \"tile_cache\" not in globals():\n",
        "    tile_cache = {}\n",
        "\n",
        "def latlon_to_world_px(lat, lon, z):\n",
        "    n = 2 ** z\n",
        "    x = (lon + 180.0) / 360.0 * n * 256.0\n",
        "    lat_r = math.radians(lat)\n",
        "    y = (1.0 - math.asinh(math.tan(lat_r)) / math.pi) / 2.0 * n * 256.0\n",
        "    return x, y\n",
        "\n",
        "def world_px_to_latlon(px, py, z):\n",
        "    n = 2 ** z\n",
        "    lon = (px / 256.0) / n * 360.0 - 180.0\n",
        "    lat = math.degrees(math.atan(math.sinh(math.pi * (1.0 - 2.0 * (py / 256.0) / n))))\n",
        "    return lat, lon\n",
        "\n",
        "def fetch_tile(z, tx, ty):\n",
        "    key = (z, tx, ty)\n",
        "    if key in tile_cache:\n",
        "        return tile_cache[key]\n",
        "    for _ in range(2):\n",
        "        try:\n",
        "            r = session.get(TILE_URL.format(z=z, x=tx, y=ty), timeout=20)\n",
        "            r.raise_for_status()\n",
        "            arr = np.array(Image.open(io.BytesIO(r.content)).convert(\"RGB\"))\n",
        "            tile_cache[key] = arr\n",
        "            time.sleep(0.03)\n",
        "            return arr\n",
        "        except Exception:\n",
        "            time.sleep(0.3)\n",
        "    return np.zeros((256, 256, 3), dtype=np.uint8)\n",
        "\n",
        "def fetch_mosaic(cluster):\n",
        "    lats = [t[\"lat\"] for t in cluster]\n",
        "    lons = [t[\"lon\"] for t in cluster]\n",
        "    dlat = BUFFER_M / 111320.0\n",
        "    dlon = BUFFER_M / (111320.0 * math.cos(math.radians(float(np.mean(lats)))))\n",
        "    x0, y1 = latlon_to_world_px(min(lats) - dlat, min(lons) - dlon, ZOOM)\n",
        "    x1, y0 = latlon_to_world_px(max(lats) + dlat, max(lons) + dlon, ZOOM)\n",
        "\n",
        "    tx0, tx1 = int(x0 // 256), int(x1 // 256)\n",
        "    ty0, ty1 = int(y0 // 256), int(y1 // 256)\n",
        "    nx, ny = tx1 - tx0 + 1, ty1 - ty0 + 1\n",
        "    if nx * ny > MAX_TILES_PER_FARM:\n",
        "        print(f\"Skipping oversized cluster ({nx}x{ny}={nx*ny} tiles > {MAX_TILES_PER_FARM})\")\n",
        "        return None, 0, 0\n",
        "\n",
        "    mosaic = np.zeros((ny * 256, nx * 256, 3), dtype=np.uint8)\n",
        "    for ty in range(ty0, ty1 + 1):\n",
        "        for tx in range(tx0, tx1 + 1):\n",
        "            py, px = (ty - ty0) * 256, (tx - tx0) * 256\n",
        "            mosaic[py:py+256, px:px+256] = fetch_tile(ZOOM, tx, ty)\n",
        "    return mosaic, tx0 * 256, ty0 * 256\n",
        "\n",
        "def window_starts(total, win, stride):\n",
        "    if total <= win:\n",
        "        return [0]\n",
        "    starts = list(range(0, total - win + 1, stride))\n",
        "    if starts[-1] != total - win:\n",
        "        starts.append(total - win)\n",
        "    return starts\n",
        "\n",
        "def scan_cluster_obb(cluster, cid):\n",
        "    mosaic, ox, oy = fetch_mosaic(cluster)\n",
        "    if mosaic is None:\n",
        "        return None, [], [], 0\n",
        "    H, W = mosaic.shape[:2]\n",
        "    lat_mid = float(np.mean([t[\"lat\"] for t in cluster]))\n",
        "    m_per_px = 156543.03392 * math.cos(math.radians(lat_mid)) / (2 ** ZOOM)\n",
        "\n",
        "    # All mapped OSM tanks inside this mosaic\n",
        "    known_all = []\n",
        "    for t in all_osm_tanks:\n",
        "        wx, wy = latlon_to_world_px(t[\"lat\"], t[\"lon\"], ZOOM)\n",
        "        lx, ly = wx - ox, wy - oy\n",
        "        if -40 <= lx <= W + 40 and -40 <= ly <= H + 40:\n",
        "            known_all.append((lx, ly, (t[\"diam_m\"] / 2.0) / m_per_px))\n",
        "\n",
        "    # Sliding-window inference at native DOTA 1024px scale\n",
        "    raw_dets = []\n",
        "    for y0 in window_starts(H, WIN_PX, STRIDE_PX):\n",
        "        for x0 in window_starts(W, WIN_PX, STRIDE_PX):\n",
        "            crop = mosaic[y0:min(y0 + WIN_PX, H), x0:min(x0 + WIN_PX, W)]\n",
        "            preds = model.predict(\n",
        "                Image.fromarray(crop),\n",
        "                imgsz=WIN_PX,\n",
        "                conf=CONF_THRESH,\n",
        "                classes=[TANK_CLS_ID],\
