      "source": [
        "#@title 3. Fetch OSM Storage Tanks & Cluster Into Farms\n",
        "import math, json, time, requests\n",
        "import numpy as np\n",
        "from scipy.spatial import cKDTree\n",
        "\n",
        "OVERPASS_ENDPOINTS = [\n",
        "    \"https://maps.mail.ru/osm/tools/overpass/api/interpreter\",\n",
        "    \"https://overpass-api.de/api/interpreter\",\n",
        "    \"https://overpass.kumi.systems/api/interpreter\",\n",
        "    \"https://overpass.private.coffee/api/interpreter\",\n",
        "]\n",
        "\n",
        "HEADERS = {\n",
        "    \"User-Agent\": \"StorageMapper-Pilot/2.0 (+https://github.com/rawazrauf/storage_mapper)\",\n",
        "    \"Accept\": \"application/json\",\n",
        "}\n",
        "\n",
        "QUERY = f\"\"\"[out:json][timeout:120];\n",
        "area[\"ISO3166-1\"=\"{COUNTRY_ISO2}\"][admin_level=2]->.searchArea;\n",
        "way[\"man_made\"=\"storage_tank\"](area.searchArea);\n",
        "out geom tags;\"\"\"\n",
        "\n",
        "def fetch_tanks():\n",
        "    for url in OVERPASS_ENDPOINTS:\n",
        "        host = url.split(\"/\")[2]\n",
        "        for attempt in range(2):\n",
        "            try:\n",
        "                t0 = time.time()\n",
        "                r = requests.post(url, data={\"data\": QUERY}, headers=HEADERS, timeout=120)\n",
        "                if r.status_code == 429 and attempt == 0:\n",
        "                    wait = min(int(r.headers.get(\"Retry-After\", 8)), 15)\n",
        "                    print(f\"Rate-limited on {host} (429), retrying in {wait}s...\")\n",
        "                    time.sleep(wait)\n",
        "                    continue\n",
        "                r.raise_for_status()\n",
        "                data = r.json()\n",
        "                if \"elements\" in data:\n",
        "                    print(f\"Fetched {len(data['elements'])} ways from {host} in {time.time()-t0:.1f}s\")\n",
        "                    return data[\"elements\"]\n",
        "            except Exception as e:\n",
        "                print(f\"Endpoint failed ({host}): {e}\")\n",
        "                break\n",
        "    raise RuntimeError(\"All Overpass endpoints failed. Re-run this cell in a moment.\")\n",
        "\n",
        "def tank_metrics(geom):\n",
        "    n = len(geom)\n",
        "    lats = [p[\"lat\"] for p in geom]\n",
        "    lons = [p[\"lon\"] for p in geom]\n",
        "    lat_avg = sum(lats) / n\n",
        "    lon_avg = sum(lons) / n\n",
        "    cos_lat = math.cos(math.radians(lat_avg))\n",
        "    area, perim = 0.0, 0.0\n",
        "    for i in range(n - 1):\n",
        "        x0, y0 = geom[i][\"lon\"], geom[i][\"lat\"]\n",
        "        x1, y1 = geom[i + 1][\"lon\"], geom[i + 1][\"lat\"]\n",
        "        area += x0 * y1 - x1 * y0\n",
        "        dx = (x1 - x0) * cos_lat * 111320.0\n",
        "        dy = (y1 - y0) * 111320.0\n",
        "        perim += math.hypot(dx, dy)\n",
        "    area = abs(area) / 2.0 * (111320.0 ** 2) * cos_lat\n",
        "    circ = (4 * math.pi * area) / (perim ** 2) if perim > 0 else 0.0\n",
        "    diam = 2.0 * math.sqrt(area / math.pi) if area > 0 else 0.0\n",
        "    return lat_avg, lon_avg, circ, diam\n",
        "\n",
        "raw = fetch_tanks()\n",
        "all_osm_tanks = []  # used to mask ALL already-mapped tanks (including <6m)\n",
        "tanks = []          # circular >=6m tanks used for farm clustering\n",
        "\n",
        "for el in raw:\n",
        "    geom = el.get(\"geometry\", [])\n",
        "    if len(geom) < 3:\n",
        "        continue\n",
        "    lat, lon, circ, diam = tank_metrics(geom)\n",
        "    rec = {\"id\": el[\"id\"], \"lat\": lat, \"lon\": lon, \"diam_m\": max(diam, 2.0), \"geom\": geom}\n",
        "    all_osm_tanks.append(rec)\n",
        "    if circ >= 0.75 and diam >= 6.0:\n",
        "        tanks.append(rec)\n",
        "\n",
        "mid_lat = float(np.mean([t[\"lat\"] for t in tanks]))\n",
        "cos_mid = math.cos(math.radians(mid_lat))\n",
        "pts_m = np.array([[t[\"lat\"] * 111320.0, t[\"lon\"] * 111320.0 * cos_mid] for t in tanks])\n",
        "tree = cKDTree(pts_m)\n",
        "parent = list(range(len(tanks)))\n",
        "\n",
        "def find(i):\n",
        "    while parent[i] != i:\n",
        "        parent[i] = parent[parent[i]]\n",
        "        i = parent[i]\n",
        "    return i\n",
        "\n",
        "for i, j in tree.query_pairs(r=500.0):\n",
        "    ri, rj = find(i), find(j)\n",
        "    if ri != rj:\n",
        "        parent[ri] = rj\n",
        "\n",
        "groups = {}\n",
        "for idx, t in enumerate(tanks):\n",
        "    groups.setdefault(find(idx), []).append(t)\n",
        "\n",
        "clusters = sorted(groups.values(), key=len, reverse=True)\n",
        "eligible = [c for c in clusters if MIN_FARM_TANKS <= len(c) <= MAX_FARM_TANKS]\n",
        "print(f\"All OSM tanks (masking): {len(all_osm_tanks)} | Circular >=6m: {len(tanks)} across {len(clusters)} clusters\")\n",
        "print(f\"Eligible farms ({MIN_FARM_TANKS}-{MAX_FARM_TANKS} tanks): {len(eligible)} | Pilot will scan: {min(PILOT_LIMIT, len(eligible)) if PILOT_LIMIT > 0 else len(eligible)}\")\n"
      ]
    },
