      "source": [
        "#@title 2. Install Ultralytics & Load Pretrained DOTA Aerial Model\n",
        "%pip install -q ultralytics\n",
        "\n",
        "import torch\n",
        "from ultralytics import YOLO\n",
        "\n",
        "DEVICE = 0 if torch.cuda.is_available() else \"cpu\"\n",
        "if torch.cuda.is_available():\n",
        "    print(f\"GPU active: {torch.cuda.get_device_name(0)}\")\n",
        "else:\n",
        "    print(\"Running on CPU (works fine for 5 pilot farms; switch Runtime -> T4 GPU for full-country speed).\")\n",
        "\n",
        "model = YOLO(MODEL_NAME)\n",
        "tank_ids = [k for k, v in model.names.items() if \"storage\" in v.lower() and \"tank\" in v.lower()]\n",
        "if not tank_ids:\n",
        "    raise RuntimeError(f\"Could not locate 'storage tank' class in model names: {model.names}\")\n",
        "TANK_CLS_ID = tank_ids[0]\n",
        "print(f\"Loaded {MODEL_NAME} | target class {TANK_CLS_ID}: '{model.names[TANK_CLS_ID]}'\")\n"
      ]
    },
    {
      "cell_type": "code",
